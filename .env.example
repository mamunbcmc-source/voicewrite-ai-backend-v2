# Copy this file to .env and fill in real values. NEVER commit .env.

# Google Cloud Speech-to-Text
# Create a service account in Google Cloud Console -> IAM -> Service Accounts,
# grant it "Cloud Speech Client" role, download its JSON key, and either:
#   (a) set GOOGLE_APPLICATION_CREDENTIALS to the path of that JSON file, or
#   (b) paste the JSON contents into GOOGLE_CREDENTIALS_JSON (single line)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Anthropic API key for the AI writing engine (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Firebase Admin SDK (for verifying user login tokens sent from the app)
# Generate from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json

PORT=8080
